{
    "$schema": "https://opencode.ai/config.json",
    "model": {
        "providerID": "ollama",
        "model": "gemma4:e4b-64k"
    },
    "websearch": {
        "provider": "random"
    },
    "plugins": ["@cortexkit/opencode-magic-context@latest"],
    "providers": {
        "ollama": {
            "name": "Ollama",
            "package": "aisdk:@ai-sdk/openai-compatible",
            "settings": {
                "baseURL": "http://127.0.0.1:11434/v1"
            },
            "models": {
                "gemma4:e4b-64k": {
                    "name": "gemma4:e4b-64k",
                    "limit": {
                        "context": 65536,
                        "input": 65536,
                        "output": 8192
                    }
                }
            }
        }
    }
}
